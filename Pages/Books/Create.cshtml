@page
@model BookApp.Pages.Books.CreateModel

@{
    ViewData["Title"] = "Добавить книгу";
}

<h1>Добавить книгу</h1>

<form method="post">
    <div class="form-group">
        <label asp-for="Book.Title"></label>
        <input asp-for="Book.Title" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Book.Author"></label>
        <input asp-for="Book.Author" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Book.Genre"></label>
        <input asp-for="Book.Genre" class="form-control" />
    </div>
    <div class="form-group">
        <label asp-for="Book.Year"></label>
        <input asp-for="Book.Year" class="form-control" type="number" />
    </div>
    <button type="submit" class="btn btn-primary mt-2">Сохранить</button>
    <a asp-page="./Index" class="btn btn-secondary mt-2">Отмена</a>
</form>